@using D_P.Core.Application.VieiwModels.Resultados_Laboral;
@model List<ResultadosLaboratorioViewModel>
@{
    int i = 0;
    ViewData["Title"] = "Resultados de Laboratorio";
}

        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">Doctores_Pacientes</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
            </div>
        </nav>
    
            @*<div class="position-relative">*@
            @*<div class="top-50 start-50 translate-middle">*@
               @* <div class="" style="  margin:auto; margin-top:auto">*@
                   <br>
                    <div class="col-4 offset-8">
                        <a asp-action="Save" asp-controller="ResultaL" class="btn btn-outline-success">Añadir un nuevo resultado de laboratorio</a>
                    </div>
            <br />

            <div class="row">
                @if (Model == null || Model.Count == 0)
                {
                    <h3>No hay resultados agregadas</h3>
                }
                else
                {
                    <div class="col-10 offset-1">
                        <div class="card">
                            <div class="card-header bg-warning text-light">
                                <h3 class="text-center">Pruebas pendientes de Laboratorio</h3>
                            </div>
                            <div class="card-body">
                                <table class="table table-responsive">
                                    <thead>
                                        <tr>
                                            <th scope="col">#</th>
                                            <th scope="col">Paciente</th>
                                            <th scope="col">Cedula</th>
                                            <th scope="col">Prueba a realizar</th>
                                            <th scope="col">Estado</th>
                                            <th scope="col">Action</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{
                                            i = 1;
                                        }
                                        @foreach (ResultadosLaboratorioViewModel item in Model)
                                        {
                                            <tr>
                                                <th scope="row">@i</th>
                                                <td>@item.PacienteName @item.PacienteApellido</td>
                                                <td>@item.PacienteCedula</td>
                                                <td>@item.PruebaLab</td>
                                                <td>@if (item.status == 1) 
                                                    {
                                                    <a class="btn btn-danger">Pendiente consulta</a>
                                                    } else if(item.status == 2){
                                                        <a class="btn btn-warning">Pendiente Resultado</a>
                                                    } else if(item.status == 3){
                                                        <a class="btn btn-success">Completa</a>
                                                    }
                                                    </td>


                                                <td>
                                                    <a asp-action="Edit" asp-controller="ResultaL" asp-route-id="@item.Id" class="btn btn-outline-warning">Editar</a>
                                                    <a asp-action="Delete" asp-controller="ResultaL" asp-route-id="@item.Id" class="btn btn-outline-danger">Eliminar</a>
                                                </td>

                                            </tr>

                                            i++;
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                }

            </div>
            @*</div>*@